using MechanicFinder.Core.Entities;
using MechanicFinder.Core.Interfaces;
using MechanicFinder.Core.Scoring;
using MechanicFinder.Infrastructure.Data;
using Microsoft.EntityFrameworkCore;

namespace MechanicFinder.Web.Services;

public class BusinessSearchService : IBusinessSearchService
{
    private readonly MechanicFinderDbContext _context;
    private readonly SearchRankingService _rankingService = new();

    public BusinessSearchService(MechanicFinderDbContext context)
    {
        _context = context;
    }

    public async Task<List<Province>> GetProvincesAsync(CancellationToken cancellationToken = default)
    {
        return await _context.Provinces
            .OrderBy(p => p.Name)
            .ToListAsync(cancellationToken);
    }

    public async Task<List<City>> GetCitiesByProvinceAsync(int provinceId, CancellationToken cancellationToken = default)
    {
        return await _context.Cities
            .Where(c => c.ProvinceId == provinceId)
            .OrderBy(c => c.Name)
            .ToListAsync(cancellationToken);
    }

    public async Task<SearchResultModel> SearchAsync(SearchRequest request, CancellationToken cancellationToken = default)
    {
        var query = _context.Businesses
            .AsNoTracking()
            .Include(b => b.City)
            .Include(b => b.BusinessVehicleMakes)
                .ThenInclude(bvm => bvm.VehicleMake)
            .Include(b => b.BusinessSpecialties)
                .ThenInclude(bsp => bsp.SpecialtyCategory)
            .Include(b => b.Ratings)
            .Include(b => b.Evidences)
            .Where(b => b.City.ProvinceId == request.ProvinceId && b.CityId == request.CityId && b.IsActive);

        if (request.VehicleMakeId.HasValue)
        {
            query = query.Where(b => b.BusinessVehicleMakes.Any(bvm => bvm.VehicleMakeId == request.VehicleMakeId.Value));
        }

        if (request.SpecialtyCategoryId.HasValue)
        {
            query = query.Where(b => b.BusinessSpecialties.Any(bsp => bsp.SpecialtyCategoryId == request.SpecialtyCategoryId.Value));
        }

        var businesses = await query.ToListAsync(cancellationToken);
        var ranked = _rankingService.Rank(businesses, request.VehicleMakeId, request.SpecialtyCategoryId);

        var specialistResults = ranked
            .Where(r => r.Classification != SearchResultClassification.General)
            .ToList();

        var generalResults = ranked
            .Where(r => r.Classification == SearchResultClassification.General)
            .ToList();

        var model = new SearchResultModel
        {
            Title = "Search results",
            Message = specialistResults.Count > 0
                ? "Specialist candidates are shown first, followed by general service providers."
                : SearchResultMessages.NoSpecialists,
            SpecialistResults = specialistResults,
            GeneralResults = generalResults
        };

        if (ranked.Count == 0)
        {
            model.Message = SearchResultMessages.NoMatches;
        }

        return model;
    }
}
